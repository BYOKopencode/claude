# Authentication (enabled by default)
REQUIRE_API_KEY=true

# Multi-user configuration: use a file and/or inline JSON.
OMNIROGUE_USERS_FILE=users.json
# OMNIROGUE_USERS=[{"name":"Alice","api_key":"sk-alice-CHANGE-ME","session_id":"sess_xxx","user_id":"user_xxx","user_email":"alice@example.com","instance_id":"ins_xxx","jwt":"eyJ...","client_cookie":"...","client_uat":"...","cf_bm":"...","cfuvid":"..."}]

# Optional legacy single-user mode (all values are required if any are set)
# OMNIROGUE_API_KEY=sk-local-CHANGE-ME
# OMNIROGUE_SESSION_ID=sess_xxx
# OMNIROGUE_USER_ID=user_xxx
# OMNIROGUE_USER_EMAIL=you@example.com
# OMNIROGUE_INSTANCE_ID=ins_xxx
# OMNIROGUE_JWT=eyJhbGci...
# OMNIROGUE_CLIENT_COOKIE=eyJhbGci...
# OMNIROGUE_CLIENT_UAT=1234567890
# OMNIROGUE_CF_BM=...
# OMNIROGUE_CFUVID=...

# Optional endpoint overrides
OMNIROGUE_CLERK_BASE=https://clerk.omnirogue.com
OMNIROGUE_FRONTEND_BASE=https://omnirogue.com
OMNIROGUE_API_BASE=https://api.omnirogue.com

PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info
MCP_SERVER_NAME=omnirogue-agent
MCP_SERVER_VERSION=1.0.0
